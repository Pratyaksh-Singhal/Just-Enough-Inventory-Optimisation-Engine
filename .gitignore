# Raw M5 extracts and derived warehouse — too large for git, rebuildable from Kaggle.
data/*.csv
data/*.duckdb
data/*.duckdb.wal
data/*.parquet

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

mlruns/
mlartifacts/

node_modules/
dashboard/dist/
.env

# Tier 2: users' own uploaded sales history. Never in the repo, never in a backup that
# was not deliberately configured to hold it.
data/uploads/

# Agent tooling — installed artefacts, not project source (~1,050 files).
# .claude/settings.json is deliberately NOT ignored: the permission config is team-wide.
.claude/skills/
_bmad/
_bmad-output/
design-artifacts/

# ...but the festival demand reference IS source, not a rebuildable extract. priors.py
# calls its absence a packaging fault and fails on it, which the rule above would cause.
!data/india_festival_demand.csv

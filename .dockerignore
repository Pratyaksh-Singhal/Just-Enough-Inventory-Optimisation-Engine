# Build context control. Without this file the context is ~1.8 GB -- .venv at 1.1 GB and data/ at

# --- The two that matter ---------------------------------------------------------------
.venv/
venv/
env/

# Raw M5 extracts, the derived warehouse, and users' uploaded history.
/data/
!src/inventory_engine/data/

# --- VCS and CI ------------------------------------------------------------------------
.git/
.gitignore
.gitattributes
.github/

# --- Python build and test residue -----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log

# --- Experiment tracking ---------------------------------------------------------------
mlruns/
mlartifacts/

# --- Agent tooling and planning artefacts, not application source -----------------------
.claude/
_bmad/
_bmad-output/
design-artifacts/
wds-0-project-setup/
wds-1-project-brief/
wds-2-requirements-analysis/

# --- Not copied by the Dockerfile ------------------------------------------------------
tests/
# NOT ignored: dashboard/. The service now serves the built page at / so that the Full forecast
dashboard/*
!dashboard/index.html
node_modules/
# Documentation is read on GitHub, not served by the container.
docs/
scripts/
migrations/versions/__pycache__/

# --- Editor / OS -----------------------------------------------------------------------
.vscode/
.idea/
.cursor/
.DS_Store
Thumbs.db
*.swp

# --- Local env; secrets come from `fly secrets`, never from the image -------------------
.env
.env.*
docker-compose.yml
Dockerfile

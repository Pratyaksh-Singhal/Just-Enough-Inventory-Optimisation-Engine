# Tier 2 service configuration. Copy to .env and fill in.
# .env is gitignored. No key in this file is real.

# --- Postgres ---------------------------------------------------------------
# Local (docker compose up db):
DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory
# Hosted (Neon and friends): same driver, different host. Nothing else changes.
# DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/inventory?sslmode=require

# --- Queue ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800

# --- Observability ----------------------------------------------------------
# Both are optional: unset disables the integration rather than erroring, so the stack
# runs locally with no accounts. See the README for exactly what is sent.
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ENVIRONMENT=development

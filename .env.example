# Tier 2 configuration. Copy to .env and fill in; .env is gitignored.
# No value in this file is real.

DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory
REDIS_URL=redis://localhost:6379

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800
# Age past which an upload and everything derived from it is destroyed. Must be positive.
UPLOAD_RETENTION_DAYS=30

# Optional. Unset disables the integration rather than erroring.
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Seed for the day-scoped visitor hash; unset means each process invents its own.
ANALYTICS_SALT=
ENVIRONMENT=development
